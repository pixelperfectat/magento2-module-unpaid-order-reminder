<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="pixelperfect_unpaid_order_reminder" translate="label" type="text" sortOrder="500" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Unpaid Order Reminder</label>
            <tab>sales</tab>
            <resource>PixelPerfect_UnpaidOrderReminder::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>No reminder is sent while this is No.</comment>
                </field>
                <field id="sender" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="max_age_days" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Do not remind orders older than (days)</label>
                    <comment>Orders older than this are never reminded. Protects the first run after switch-on from mailing the shop's whole history of unpaid orders. Use 0 for no limit.</comment>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="bcc" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send copy to</label>
                    <comment>Optional. Comma-separated addresses.</comment>
                    <validate>validate-emails</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="rules" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Reminder rules</label>
                <comment>One row per payment method. A method with no row is never reminded about.</comment>
                <field id="methods" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Rules</label>
                    <frontend_model>PixelPerfect\UnpaidOrderReminder\Block\Adminhtml\Form\Field\RulesTable</frontend_model>
                    <backend_model>PixelPerfect\UnpaidOrderReminder\Model\Config\Backend\Rules</backend_model>
                    <depends><field id="pixelperfect_unpaid_order_reminder/general/enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
