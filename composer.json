{
  "name": "pixelperfectat/magento2-module-unpaid-order-reminder",
  "description": "Reminds a shopper about an order still awaiting payment, with the instructions needed to complete it",
  "type": "magento2-module",
  "license": "MIT",
  "keywords": ["magento", "magento2", "payment", "reminder", "bank-transfer", "pending-payment"],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "magento/*": true,
      "phpstan/extension-installer": true
    }
  },
  "repositories": [
    { "type": "composer", "url": "https://repo.magento.com/" }
  ],
  "require": {
    "php": "^8.3",
    "magento/framework": "103.0.*",
    "magento/module-config": "101.2.*",
    "magento/module-email": "101.1.*",
    "magento/module-payment": "100.4.*",
    "magento/module-sales": "103.0.*",
    "magento/module-store": "101.1.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "pixelperfectat/coding-standard": "^0.1.0"
  },
  "autoload": {
    "files": ["registration.php"],
    "psr-4": { "PixelPerfect\\UnpaidOrderReminder\\": "" }
  },
  "extra": {
    "branch-alias": { "dev-main": "0.3.x-dev" }
  },
  "scripts": {
    "lint": "parallel-lint --exclude vendor --exclude generated .",
    "cs": "phpcs",
    "cs:fix": "phpcbf",
    "stan": "phpstan analyse",
    "test": "phpunit",
    "ci:validate": "@composer validate --no-check-publish",
    "ci:normalize": "@composer normalize --dry-run --diff",
    "check": ["@ci:validate", "@lint", "@cs", "@stan", "@test"]
  }
}
